# Production environment variables
# Copy this file to .env.prod and adjust values as needed

# Martin tile server
MARTIN_PORT=3000

# PostgREST settings
PGRST_DB_URI=postgres://openmaptiles:openmaptiles@postgres-imm:5432/openmaptiles
PGRST_OPENAPI_SERVER_PROXY_URI=http://127.0.0.1:3000
PGRST_DB_ANON_ROLE=web_anon

# PostgreSQL (immutable)
POSTGRES_DB=openmaptiles
POSTGRES_USER=openmaptiles
POSTGRES_PASSWORD=openmaptiles

# LOD cache
LOD_PORT=1337

# Traefik labels (adjust for your domain)
DOMAIN=tiles2.ijo42.ru
CERT_RESOLVER=ijoresolv
ALLOWED_SUBNET=212.192.64.0/19

