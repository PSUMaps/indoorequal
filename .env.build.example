# Build stage environment variables
# Copy this file to .env and adjust values as needed

# Database connection (for build stage)
POSTGRES_HOST=postgres-build
POSTGRES_PORT=5432
POSTGRES_DB=openmaptiles
POSTGRES_USER=openmaptiles
POSTGRES_PASSWORD=openmaptiles

# OSM import settings
DIFF_MODE=false
MIN_ZOOM=0
MAX_ZOOM=14

# Bounding box (leave empty to use entire PBF file)
BBOX=

# Imposm config file
IMPOSM_CONFIG_FILE=/mapping/imposm3.yaml

# Parallel processing
MAX_PARALLEL_PSQL=5

# Area to import (without .osm.pbf extension)
AREA=campus

